# 复制为 .env 后 scripts/dev.ps1 会加载；测试不读取此文件。
RAG_PROJECT_DIR=rag
# 可选；不填写时使用 rag/.runtime/dashscope.local.json。不要提交真实密钥。
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认 data/site.sqlite3；修改此路径相当于选择另一份数据库。
# HANDBOOK_DATABASE_PATH=D:/all_try/codex_try/fast_api/data/site.sqlite3
COOKIE_SECURE=false
# 安装助手独立调用千问，不改变原 RAG 的生成配置。
ASSISTANT_MODEL=qwen3.7-plus
