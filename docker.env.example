# Copy this file to docker.env and configure your own API key and base URL.
# Never commit docker.env or share your real API key.
# The API URL and models must pass this project's current compatibility checks.
DASHSCOPE_API_KEY=replace_with_your_own_api_key
DASHSCOPE_BASE_URL=replace_with_a_project_compatible_https_api_base_url
COOKIE_SECURE=false
